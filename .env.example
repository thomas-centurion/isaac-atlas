# API
PORT=4000
MONGODB_URI=mongodb://localhost:27017/isaac-atlas
SESSION_SECRET=change-me-in-dev
WEB_ORIGIN=http://localhost:5173

# Script de catalogo (carpeta extracted_resources del juego)
ISAAC_EXTRACTED=

# Auth (todo opcional en desarrollo)
# Base publica para callbacks OAuth y links de mails (por defecto WEB_ORIGIN)
PUBLIC_URL=
# Google: https://console.cloud.google.com/apis/credentials (redirect URI: <PUBLIC_URL>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Steam: solo para traer el avatar (el login por OpenID no la necesita)
STEAM_API_KEY=
# Sin SMTP_URL los mails se imprimen en la consola de la API
SMTP_URL=
MAIL_FROM=Isaac Atlas <no-reply@isaac-atlas.local>

# Produccion (ver docs/DEPLOY.md)
# Carpeta del build de la web; si existe, la API la sirve (en produccion se busca ../web/dist)
WEB_DIST=
# Proxies delante de la API (hosting = 1, Cloudflare + hosting = 2)
TRUST_PROXY=1
# Solo para probar un build de produccion por http local: COOKIE_SECURE=false
COOKIE_SECURE=
